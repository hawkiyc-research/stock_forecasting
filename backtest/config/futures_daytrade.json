{
  "schema_version": "1.0",
  "name": "stock-futures-short-daytrade",
  "description": "Pre-registered stock-futures short-side day trade (experiment protocol section 13.15): bottom-q names by the previous close's h = 1 score, shorted at the futures open and covered at the daily settlement, on official TAIFEX prices; long-short and TX-hedged versions and capital scenarios are descriptive.",
  "horizon": 1,
  "universe": {"min_volume": 100, "lookback_sessions": 20, "require_open": true},
  "grid": {"bottom_fractions": [0.1, 0.2]},
  "leverage": 1.0,
  "margin": {"initial_rate": 0.2025, "maintenance_rate": 0.1553},
  "capital": {
    "primary": "fractional",
    "participation_cap": 0.05,
    "scenarios": [
      {"name": "10M", "twd": 10000000},
      {"name": "30M", "twd": 30000000},
      {"name": "100M", "twd": 100000000},
      {"name": "300M", "twd": 300000000},
      {"name": "1B", "twd": 1000000000}
    ],
    "infeasible_skip_share": 0.5
  },
  "costs": {
    "tax_rate": 0.00002,
    "commission_per_contract_twd": [30, 60],
    "slippage_ticks": [1, 2],
    "primary": {"commission_per_contract_twd": 30, "slippage_ticks": 1},
    "tick_bands": [[10, 0.01], [50, 0.05], [100, 0.1], [500, 0.5], [1000, 1.0], [null, 5.0]]
  },
  "tx": {
    "root": "diagnostics/taifex-tx",
    "contract": "TX",
    "multiplier": 200,
    "tax_rate": 0.00002,
    "commission_per_contract_twd": 50,
    "slippage_points": 1
  },
  "taifex_root": "diagnostics/taifex-all",
  "versions": ["short_only", "long_short", "hedged"],
  "annualization_days": 252,
  "bootstrap": {"replicates": 1000, "seed": 11, "block": 5},
  "periods": {"P1": ["2023-01-02", "2025-06-01"], "P2": ["2025-06-01", "2026-06-01"]},
  "selection": {"period": "P1", "version": "short_only", "metric": "sharpe"},
  "decision": {
    "hypothesis": "H-E",
    "period": "P1+P2",
    "version": "short_only",
    "lower_bound_above": 0.0,
    "require_positive_period": "P2"
  }
}
