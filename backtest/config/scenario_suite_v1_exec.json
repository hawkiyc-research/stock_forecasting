    "min_close": 10,
    "exclude_etf": true
  },
  "signal": {
    "half_life_sessions": 3,
    "max_gap_sessions": 5
  },
  "multi_day": {
    "grid": {
      "score_horizons": [
        5,
        10
      ],
      "k": [
        30,
        50
      ],
      "buffer_multiples": [
        2,
        3
      ]
    },
    "fixed": {
      "t-lgbm-alpha-residual_v1a": {
        "h": 10,
        "k": 50,
        "buffer": 3
      },
      "t-xs-scratch": {
        "h": 10,
        "k": 50,
        "buffer": 2
      }
    },
    "entry_cap_fraction": 0.1,
    "bootstrap_block": 21
  },
  "day_trade": {
    "horizon": 1,
    "grid": {
      "fractions": [
        0.05,
        0.1
      ]
    },
    "bootstrap_block": 5
  },
  "combination": {
    "multi_day_weight": 0.5,
    "day_trade_weight": 0.5,
    "bootstrap_block": 21
  },
  "price_limit": {
    "open_gap": 0.095
