      "codes": [
        "TWSE"
      ],
      "index": "TAIEX.TW",
      "min_dollar_volume": 30000000
    },
    "TPEX": {
      "codes": [
        "TPEX"
      ],
      "index": "TPEX.TWO",
      "min_dollar_volume": 10000000
    }
  },
  "combined_market": {
