{
  "schema_version": "1.0",
  "name": "scenario-suite-execution-layer",
  "description": "Experiment protocol section 13.19 supplement 4: the orthogonalized (v1, unmatched) S1 / S2 with the execution-uncertainty layer on the short book: borrowable universe from the tw_chip_data eligibility lists, next-session lending quota as a value cap in the capital scenarios, borrow-failure draws by dollar-volume tercile, recall probability and tiered borrow fees; five random replicates averaged. Parameters fixed to the section 13.19 selection (no re-selection). Run with --chip-data-root <tw_chip_data>/data.",
  "cost_profiles": "cost_profiles.json",
  "scenarios": [
    "md_ls",
    "md_ls_tx"
  ],
  "construction": {
    "score_variants": [
      "v1"
    ],
    "leg_matching": [
      "none"
    ]
  },
  "markets": {
